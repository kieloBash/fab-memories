# .env.prod-setup.example
#
# Copy to `.env.prod-setup` (git-ignored), fill in, run `npm run seed:prod`, then DELETE the filled-in file.
# Used ONLY by the production setup seed (prisma/seeds/prod-setup.ts). Walkthrough: documents/PROD_SETUP_SEED.md

# ── Target ─────────────────────────────────────────────────────────
# The PRODUCTION database. Use the direct (port 5432) owner connection from Supabase.
DATABASE_URL=
# The PRODUCTION Clerk instance — the same secret key Vercel uses (sk_live_… or sk_test_…).
CLERK_SECRET_KEY=

# ── Accounts ───────────────────────────────────────────────────────
# All 12 values are required. Passwords: 12+ characters, at least one letter and one number, different per person,
# never the demo password. EMAIL must be a real inbox — staff alerts are sent there (it is NOT a sign-in identifier;
# staff sign in at /staff-login with USERNAME + PASSWORD). USERNAME: 4–64 letters, numbers, "-" or "_".

PROD_ADMIN_USERNAME=
PROD_ADMIN_FULLNAME=
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=

PROD_COORD1_USERNAME=
PROD_COORD1_FULLNAME=
PROD_COORD1_EMAIL=
PROD_COORD1_PASSWORD=

PROD_COORD2_USERNAME=
PROD_COORD2_FULLNAME=
PROD_COORD2_EMAIL=
PROD_COORD2_PASSWORD=
