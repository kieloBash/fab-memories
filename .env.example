# Supabase Postgres — pooler (6543) for runtime, direct (5432) for migrations
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SIGNING_SECRET=whsec_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase storage (payment proofs)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Gmail through Nodemailer (lib/email/send.ts). Set ONE of the two options below.
# With neither set, emails are only printed to the server log (fine for local development).
# The Gmail account that sends the emails:
GMAIL_USER=
# Option A — OAuth2 (recommended; same as LiveAdmin). See docs/email/README.md for how to get these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Option B — App Password (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_APP_PASSWORD=
# Sender name shown in the inbox (optional)
EMAIL_FROM_NAME="Fab Memories Events"