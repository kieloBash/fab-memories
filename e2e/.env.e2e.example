# e2e/.env.e2e.example  →  copy to e2e/.env.e2e (git-ignored) and fill in.

# Where to run. Default: the live site.
E2E_BASE_URL=https://fab-memories.vercel.app

# Clerk keys of the instance the site uses (needed for Clerk "testing tokens", which stop Clerk's
# bot protection from blocking the automated browser). Same values as in Vercel.
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Test accounts — create these BEFORE running (see README §2). Use them only for testing.
E2E_ADMIN_USERNAME=e2e_admin
E2E_ADMIN_PASSWORD=
E2E_COORDINATOR_USERNAME=e2e_coord1
E2E_COORDINATOR_PASSWORD=
E2E_COORDINATOR2_USERNAME=e2e_coord2
E2E_COORDINATOR2_PASSWORD=
E2E_CLIENT_EMAIL=e2e.client1+clerk_test@example.com
E2E_CLIENT_PASSWORD=
E2E_CLIENT2_EMAIL=e2e.client2+clerk_test@example.com
E2E_CLIENT2_PASSWORD=

# Optional tests (left out unless set):
# TC-FR01-02 creates a brand-new client through the sign-up page. Needs Clerk test mode
# (+clerk_test e-mail, code 424242). Always on for Clerk development instances (pk_test_...).
E2E_ALLOW_SIGNUP=false
# TC-FR27-02 triggers the due-date reminder job. Same value as CRON_SECRET in Vercel.
E2E_CRON_SECRET=

# Everything the suite creates is tagged with this prefix (venues, vendor and package names)
# so e2e/scripts/cleanup-e2e-data.ts can find and remove it.
E2E_TAG=E2E-
