// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COORDINATOR
  VENDOR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VERIFY
  CONFIRM
  DECLINE
  EXPORT
  VIEW
}

enum AuditModule {
  AUTH
  USER_MANAGEMENT
  BOOKING
  PAYMENT
  VENDOR
  STAFF_SCHEDULE
  DOCUMENT
  REPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventType {
  WEDDING
  DEBUT
  CORPORATE
  BIRTHDAY
  OTHER
}

// ── Module 3 enums ────────────────────────────────────────────

enum PaymentMethod {
  GCASH
  MAYA
  BANK_TRANSFER
  CHEQUE       // deposit only — enforced in application layer
  CASH
}

enum PaymentType {
  DEPOSIT      // reservation deposit — verification triggers booking confirmation
  INSTALLMENT  // subsequent payments per contract schedule
}

enum PaymentStatus {
  PENDING      // created but client has not submitted proof yet
  SUBMITTED    // client uploaded proof, awaiting staff verification
  VERIFIED     // staff confirmed payment received
  FLAGGED      // staff flagged as invalid — client must resubmit
}

enum InstallmentStatus {
  UNPAID
  PAID
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  role      Role
  email     String?  @unique
  username  String?  @unique
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  bookings         Booking[]           // CLIENT bookings
  confirmedBy      Booking[]           @relation("BookingConfirmedBy")
  verifiedPayments Payment[]           @relation("PaymentVerifiedBy")

  @@index([role])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  module      AuditModule
  description String
  status      AuditStatus @default(SUCCESS)
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Package {
  id          String    @id @default(cuid())
  name        String
  description String?
  eventType   EventType
  price       Decimal   @db.Decimal(10, 2)
  inclusions  String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]

  @@index([eventType])
  @@index([isActive])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  client             User          @relation(fields: [clientId], references: [id])
  packageId          String
  package            Package       @relation(fields: [packageId], references: [id])
  eventType          EventType
  eventDate          DateTime      @db.Date
  eventTime          DateTime?     @db.Time
  venue              String
  guestCount         Int
  status             BookingStatus @default(PENDING)
  notes              String?

  // Populated when the reservation deposit is verified by staff.
  // This is the trigger that moves status → CONFIRMED.
  depositVerifiedAt   DateTime?
  depositVerifiedById String?
  confirmedBy         User?         @relation("BookingConfirmedBy", fields: [depositVerifiedById], references: [id])

  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments     Payment[]
  installments Installment[]

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([packageId])
}

// ── Module 3 — Payments & Installments ───────────────────────

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])

  paymentType     PaymentType   // DEPOSIT | INSTALLMENT
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)

  // Proof of payment — one of these will be set on submission
  proofImageUrl   String?       // Supabase Storage signed path
  proofStoragePath String?      // raw storage path for signed URL generation
  referenceNumber String?       // for GCash / Maya / bank transfer ref no.

  // Verification
  verifiedById    String?
  verifiedBy      User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  verificationNote String?

  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // If this payment covers an installment, link it here
  installment     Installment?  @relation("InstallmentPayment")

  @@index([bookingId])
  @@index([status])
  @@index([paymentType])
}

model Installment {
  id        String            @id @default(cuid())
  bookingId String
  booking   Booking           @relation(fields: [bookingId], references: [id])

  order     Int               // 1-based position in the schedule
  dueDate   DateTime          @db.Date
  amount    Decimal           @db.Decimal(10, 2)
  status    InstallmentStatus @default(UNPAID)
  note      String?           // admin note when creating the schedule

  // Linked when a VERIFIED INSTALLMENT payment covers this installment
  paymentId String?           @unique
  payment   Payment?          @relation("InstallmentPayment", fields: [paymentId], references: [id])

  paidAt    DateTime?         // set when status flips to PAID
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
}
