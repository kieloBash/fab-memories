// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COORDINATOR
  VENDOR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VERIFY
  CONFIRM
  DECLINE
  EXPORT
  VIEW
}

enum AuditModule {
  AUTH
  USER_MANAGEMENT
  BOOKING
  PAYMENT
  VENDOR
  STAFF_SCHEDULE
  DOCUMENT
  REPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventType {
  WEDDING
  DEBUT
  CORPORATE
  BIRTHDAY
  OTHER
}

// ── Module 3 enums ────────────────────────────────────────────

enum PaymentMethod {
  GCASH
  BANK_TRANSFER
  CASH
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING     // awaiting client submission
  SUBMITTED   // client uploaded proof, awaiting staff verification
  VERIFIED    // staff confirmed payment received
  FLAGGED     // staff flagged as invalid / needs resubmission
}

enum InstallmentStatus {
  UNPAID
  PAID
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  role      Role
  email     String?  @unique
  username  String?  @unique
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs   AuditLog[]
  bookings    Booking[]           // CLIENT bookings
  confirmedBy Booking[]           @relation("BookingConfirmedBy")
  verifiedPayments Payment[]      @relation("PaymentVerifiedBy")

  @@index([role])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  module      AuditModule
  description String
  status      AuditStatus @default(SUCCESS)
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Package {
  id          String    @id @default(cuid())
  name        String
  description String?
  eventType   EventType
  price       Decimal   @db.Decimal(10, 2)
  inclusions  String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]

  @@index([eventType])
  @@index([isActive])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  client             User          @relation(fields: [clientId], references: [id])
  packageId          String
  package            Package       @relation(fields: [packageId], references: [id])
  eventType          EventType
  eventDate          DateTime      @db.Date
  eventTime          DateTime?     @db.Time
  venue              String
  guestCount         Int
  status             BookingStatus @default(PENDING)
  notes              String?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?         @relation("BookingConfirmedBy", fields: [confirmedById], references: [id])
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([packageId])
}

// ── Module 3 — Payments & Installments ───────────────────────

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)

  // Proof of payment — one of these will be set on submission
  proofImageUrl  String?       // Supabase Storage URL (screenshot)
  referenceNumber String?      // for bank transfer / GCash ref no.

  // Verification
  verifiedById   String?
  verifiedBy     User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  verificationNote String?     // staff note on verify or flag

  submittedAt    DateTime?     // when client submitted proof
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  installments   Installment[]

  @@index([bookingId])
  @@index([status])
}

model Installment {
  id        String            @id @default(cuid())
  paymentId String
  payment   Payment           @relation(fields: [paymentId], references: [id])
  dueDate   DateTime          @db.Date
  amount    Decimal           @db.Decimal(10, 2)
  status    InstallmentStatus @default(UNPAID)
  paidAt    DateTime?
  note      String?
  order     Int               // 1-based position in the schedule

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([dueDate])
}
