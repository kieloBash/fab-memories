// prisma/schema.prisma
// CHANGE: added agreedPrice Decimal to Booking model.
// This stores the price the client agreed to at booking time
// (provincial rate if applicable, otherwise standard rate).
// All price displays and installment calculations use this field
// instead of booking.package.price, which can drift if the package
// price is later updated by admin.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COORDINATOR
  VENDOR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VERIFY
  CONFIRM
  DECLINE
  EXPORT
  VIEW
}

enum AuditModule {
  AUTH
  USER_MANAGEMENT
  BOOKING
  PAYMENT
  VENDOR
  STAFF_SCHEDULE
  DOCUMENT
  REPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CANCELLATION_REQUESTED
}

enum EventType {
  WEDDING
  DEBUT
  CORPORATE
  BIRTHDAY
  OTHER
}

enum PaymentMethod {
  GCASH
  MAYA
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum InstallmentStatus {
  UNPAID
  PAID
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  role      Role
  email     String?  @unique
  username  String?  @unique
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  bookings         Booking[]
  confirmedBy      Booking[]  @relation("BookingConfirmedBy")
  verifiedPayments Payment[]  @relation("PaymentVerifiedBy")

  @@index([role])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  module      AuditModule
  description String
  status      AuditStatus @default(SUCCESS)
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Package {
  id              String    @id @default(cuid())
  name            String
  description     String?
  eventType       EventType
  price           Decimal   @db.Decimal(10, 2)
  priceProvincial Decimal?  @db.Decimal(10, 2)
  inclusions      String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings Booking[]

  @@index([eventType])
  @@index([isActive])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  client             User          @relation(fields: [clientId], references: [id])
  packageId          String
  package            Package       @relation(fields: [packageId], references: [id])
  eventType          EventType
  eventDate          DateTime      @db.Date
  eventTime          DateTime?     @db.Time
  venue              String
  venueLatitude         Float?
  venueLongitude        Float?
  venueFormattedAddress String?

  guestCount         Int
  status             BookingStatus @default(PENDING)
  notes              String?
  packageCustomizations String[]  @default([])

  // ── NEW: price locked at booking time ─────────────────────
  // Set from package.priceProvincial (if isProvincial) or package.price.
  // Never changes after creation regardless of package price updates.
  isProvincial       Boolean  @default(false)
  agreedPrice        Decimal  @db.Decimal(10, 2)

  cancellationRequestReason  String?
  cancellationRequestedAt    DateTime?
  depositVerifiedAt          DateTime?
  depositVerifiedById        String?
  confirmedBy                User?         @relation("BookingConfirmedBy", fields: [depositVerifiedById], references: [id])
  cancellationReason         String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  payments     Payment[]
  installments Installment[]

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([packageId])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  paymentType      PaymentType
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  proofImageUrl    String?
  proofStoragePath String?
  referenceNumber  String?
  installmentId    String?
  installment      Installment?  @relation("InstallmentPayment", fields: [installmentId], references: [id])
  verifiedById     String?
  verifiedBy       User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  verificationNote String?
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([paymentType])
  @@index([installmentId])
}

model Installment {
  id        String            @id @default(cuid())
  bookingId String
  booking   Booking           @relation(fields: [bookingId], references: [id])
  order     Int
  dueDate   DateTime          @db.Date
  amount    Decimal           @db.Decimal(10, 2)
  status    InstallmentStatus @default(UNPAID)
  note      String?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments Payment[] @relation("InstallmentPayment")

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
}
