// prisma/schema.prisma
// CHANGES FROM PREVIOUS VERSION (Module 7 — Secured Event Planning and Audit Trail):
//   + AuditLog.sequence, previousHash, hash — hash-chain fields for tamper detection
//   + AuditLog.metadata now forced to Postgres `json` (not `jsonb`) via @db.Json —
//     jsonb silently reorders object keys on storage, which would make the same
//     logical metadata hash differently after a round-trip through the DB even
//     with zero tampering. Plain `json` preserves the original text.
//   + model AuditChainState — singleton row locked via SELECT ... FOR UPDATE
//     inside logAction()'s transaction, serializing all writes so no two audit
//     entries can ever be created against the same previousHash (which would
//     fork the chain and defeat the tamper-detection guarantee).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COORDINATOR
  VENDOR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VERIFY
  CONFIRM
  DECLINE
  EXPORT
  VIEW
}

enum AuditModule {
  AUTH
  USER_MANAGEMENT
  BOOKING
  PAYMENT
  VENDOR
  STAFF_SCHEDULE
  DOCUMENT
  REPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CANCELLATION_REQUESTED
}

enum EventType {
  WEDDING
  DEBUT
  CORPORATE
  BIRTHDAY
  OTHER
}

enum PaymentMethod {
  GCASH
  MAYA
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
  FULL_BALANCE
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum InstallmentStatus {
  UNPAID
  PAID
}

enum PaymentPlan {
  FULL
  INSTALLMENT
}

enum VendorCategory {
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  FLORALS
  DECORATION
  SOUNDS_LIGHTING
  VENUE
  HAIR_MAKEUP
  ENTERTAINMENT
  TRANSPORTATION
  OTHER
}

enum StaffTaskRole {
  LEAD_COORDINATOR
  GUEST_REGISTRATION
  VENDOR_LIAISON
  LOGISTICS
  PROGRAM_FLOW
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  role      Role
  email     String?  @unique
  username  String?  @unique
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  bookings         Booking[]
  confirmedBy      Booking[]         @relation("BookingConfirmedBy")
  verifiedPayments Payment[]         @relation("PaymentVerifiedBy")
  staffAssignments StaffAssignment[] @relation("CoordinatorAssignments")

  @@index([role])
}

/**
 * NEW: singleton row (id is always 1) tracking the tip of the audit
 * hash chain. logAction() locks this row with SELECT ... FOR UPDATE
 * inside a transaction before computing the next entry's hash — this
 * is what guarantees the chain can never fork under concurrent writes.
 */
model AuditChainState {
  id           Int      @id @default(1)
  lastHash     String?
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  /// Strictly increasing chain position, assigned inside the same locked
  /// transaction as the hash computation — never DB autoincrement, so it
  /// can never disagree with AuditChainState.lastSequence.
  sequence Int @unique

  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  module      AuditModule
  description String
  status      AuditStatus @default(SUCCESS)
  metadata    Json?

  /// Hash of the previous entry in the chain (null only for the very
  /// first entry ever written — the genesis entry).
  previousHash String?

  /// SHA-256 of (sequence, previousHash, userId, action, module,
  /// description, status, canonicalized metadata, createdAt). See
  /// lib/audit/chain.ts for the exact algorithm.
  hash String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@index([sequence])
}

model Package {
  id              String    @id @default(cuid())
  name            String
  description     String?
  eventType       EventType
  price           Decimal   @db.Decimal(10, 2)
  priceProvincial Decimal?  @db.Decimal(10, 2)
  inclusions      String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings Booking[]

  @@index([eventType])
  @@index([isActive])
}

model Vendor {
  id             String         @id @default(cuid())
  name           String
  category       VendorCategory
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactChannel String?
  coverageAreas  String[]       @default([])
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments BookingVendor[]

  @@index([category])
  @@index([isActive])
}

model BookingVendor {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  category    VendorCategory
  notes       String?
  contactedAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([bookingId, vendorId])
  @@index([bookingId])
  @@index([vendorId])
}

model StaffAssignment {
  id            String  @id @default(cuid())
  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coordinatorId String
  coordinator   User    @relation("CoordinatorAssignments", fields: [coordinatorId], references: [id], onDelete: Cascade)

  taskRole StaffTaskRole
  taskNote String?
  isBackup Boolean       @default(false)
  notes    String?

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookingId, coordinatorId])
  @@index([bookingId])
  @@index([coordinatorId])
}

model Booking {
  id                    String        @id @default(cuid())
  clientId              String
  client                User          @relation(fields: [clientId], references: [id])
  packageId             String
  package               Package       @relation(fields: [packageId], references: [id])
  eventType             EventType
  eventDate             DateTime      @db.Date
  eventTime             DateTime?     @db.Time
  venue                 String
  venueLatitude         Float?
  venueLongitude        Float?
  venueFormattedAddress String?
  guestCount            Int
  status                BookingStatus @default(PENDING)
  notes                 String?
  packageCustomizations String[]      @default([])

  clientPhone String

  vendorCategories VendorCategory[] @default([])

  isProvincial Boolean @default(false)
  agreedPrice  Decimal @db.Decimal(10, 2)

  paymentPlan        PaymentPlan?
  depositAmount      Decimal?     @db.Decimal(10, 2)
  depositDueDate     DateTime?
  fullPaymentDueDate DateTime?
  staffNote          String?

  cancellationRequestReason String?
  cancellationRequestedAt   DateTime?
  depositVerifiedAt         DateTime?
  depositVerifiedById       String?
  confirmedBy               User?     @relation("BookingConfirmedBy", fields: [depositVerifiedById], references: [id])
  cancellationReason        String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  payments         Payment[]
  installments     Installment[]
  vendors          BookingVendor[]
  staffAssignments StaffAssignment[]

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([packageId])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  paymentType      PaymentType
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  proofImageUrl    String?
  proofStoragePath String?
  referenceNumber  String?
  installmentId    String?
  installment      Installment?  @relation("InstallmentPayment", fields: [installmentId], references: [id])
  verifiedById     String?
  verifiedBy       User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  verificationNote String?
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([paymentType])
  @@index([installmentId])
}

model Installment {
  id        String            @id @default(cuid())
  bookingId String
  booking   Booking           @relation(fields: [bookingId], references: [id])
  order     Int
  dueDate   DateTime          @db.Date
  amount    Decimal           @db.Decimal(10, 2)
  status    InstallmentStatus @default(UNPAID)
  note      String?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments Payment[] @relation("InstallmentPayment")

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
}
