// prisma/schema.prisma
// CHANGES FROM PREVIOUS VERSION (Module 5 — Staff Scheduling):
//   + enum StaffTaskRole
//   + model StaffAssignment
//   + Booking.staffAssignments  StaffAssignment[]
//   + User.staffAssignments     StaffAssignment[]   (coordinatorId → User, not a separate Coordinator model —
//     coordinators are already User rows with role = COORDINATOR, same pattern as BookingConfirmedBy)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COORDINATOR
  VENDOR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VERIFY
  CONFIRM
  DECLINE
  EXPORT
  VIEW
}

enum AuditModule {
  AUTH
  USER_MANAGEMENT
  BOOKING
  PAYMENT
  VENDOR
  STAFF_SCHEDULE
  DOCUMENT
  REPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CANCELLATION_REQUESTED
}

enum EventType {
  WEDDING
  DEBUT
  CORPORATE
  BIRTHDAY
  OTHER
}

enum PaymentMethod {
  GCASH
  MAYA
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
  FULL_BALANCE
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum InstallmentStatus {
  UNPAID
  PAID
}

enum PaymentPlan {
  FULL
  INSTALLMENT
}

enum VendorCategory {
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  FLORALS
  DECORATION
  SOUNDS_LIGHTING
  VENUE
  HAIR_MAKEUP
  ENTERTAINMENT
  TRANSPORTATION
  OTHER
}

// NEW: fixed task-role taxonomy for staff assignments (FR-38)
enum StaffTaskRole {
  LEAD_COORDINATOR
  GUEST_REGISTRATION
  VENDOR_LIAISON
  LOGISTICS
  PROGRAM_FLOW
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  role      Role
  email     String?  @unique
  username  String?  @unique
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  bookings         Booking[]
  confirmedBy      Booking[]  @relation("BookingConfirmedBy")
  verifiedPayments Payment[]  @relation("PaymentVerifiedBy")
  staffAssignments StaffAssignment[] @relation("CoordinatorAssignments") // NEW

  @@index([role])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  module      AuditModule
  description String
  status      AuditStatus @default(SUCCESS)
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Package {
  id              String    @id @default(cuid())
  name            String
  description     String?
  eventType       EventType
  price           Decimal   @db.Decimal(10, 2)
  priceProvincial Decimal?  @db.Decimal(10, 2)
  inclusions      String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings Booking[]

  @@index([eventType])
  @@index([isActive])
}

model Vendor {
  id             String         @id @default(cuid())
  name           String
  category       VendorCategory
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactChannel String?
  coverageAreas  String[]       @default([])
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments BookingVendor[]

  @@index([category])
  @@index([isActive])
}

model BookingVendor {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  category    VendorCategory
  notes       String?
  contactedAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([bookingId, vendorId])
  @@index([bookingId])
  @@index([vendorId])
}

// NEW: coordinator assigned to a booking with a designated task (FR-38)
model StaffAssignment {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coordinatorId String
  coordinator   User          @relation("CoordinatorAssignments", fields: [coordinatorId], references: [id], onDelete: Cascade)

  taskRole  StaffTaskRole
  taskNote  String? // free-text detail when taskRole = OTHER, or extra context
  isBackup  Boolean       @default(false) // FR-39: backup coordinator designation
  notes     String? // admin/coordinator note about this assignment

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookingId, coordinatorId])
  @@index([bookingId])
  @@index([coordinatorId])
}

model Booking {
  id                    String        @id @default(cuid())
  clientId              String
  client                User          @relation(fields: [clientId], references: [id])
  packageId             String
  package               Package       @relation(fields: [packageId], references: [id])
  eventType             EventType
  eventDate             DateTime      @db.Date
  eventTime             DateTime?     @db.Time
  venue                 String
  venueLatitude         Float?
  venueLongitude        Float?
  venueFormattedAddress String?
  guestCount            Int
  status                BookingStatus @default(PENDING)
  notes                 String?
  packageCustomizations String[]      @default([])

  clientPhone String

  vendorCategories VendorCategory[] @default([])

  isProvincial Boolean @default(false)
  agreedPrice  Decimal @db.Decimal(10, 2)

  paymentPlan        PaymentPlan?
  depositAmount      Decimal?     @db.Decimal(10, 2)
  depositDueDate     DateTime?
  fullPaymentDueDate DateTime?
  staffNote          String?

  cancellationRequestReason String?
  cancellationRequestedAt   DateTime?
  depositVerifiedAt         DateTime?
  depositVerifiedById       String?
  confirmedBy               User?     @relation("BookingConfirmedBy", fields: [depositVerifiedById], references: [id])
  cancellationReason        String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  payments         Payment[]
  installments     Installment[]
  vendors          BookingVendor[]
  staffAssignments StaffAssignment[] // NEW

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@index([packageId])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  paymentType      PaymentType
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  proofImageUrl    String?
  proofStoragePath String?
  referenceNumber  String?
  installmentId    String?
  installment      Installment?  @relation("InstallmentPayment", fields: [installmentId], references: [id])
  verifiedById     String?
  verifiedBy       User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  verificationNote String?
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([paymentType])
  @@index([installmentId])
}

model Installment {
  id        String            @id @default(cuid())
  bookingId String
  booking   Booking           @relation(fields: [bookingId], references: [id])
  order     Int
  dueDate   DateTime          @db.Date
  amount    Decimal           @db.Decimal(10, 2)
  status    InstallmentStatus @default(UNPAID)
  note      String?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments Payment[] @relation("InstallmentPayment")

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
}
